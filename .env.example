# === Obrigatórios ===

# Supabase (PostgreSQL)
# Crie em: https://supabase.com -> Project Settings -> Database -> Connection string
# Use a "Transaction" connection string (port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres"

# Groq API Key (grátis)
# Crie em: https://console.groq.com/keys
GROQ_API_KEY="gsk_[YOUR-GROQ-KEY]"

# WhatsApp
# Número de telefone que vai enviar as mensagens (formato: 5511999999999)
WHATSAPP_NUMBER="5511999999999"

# === Opcionais (valores padrão já configurados) ===

# Horários de entrega (formato HH:mm, separados por vírgula)
DELIVERY_TIMES="08:00,12:00,18:00"

# Fuso horário
TZ="America/Sao_Paulo"
